HELIUS_API_KEY=your_helius_api_key_here

# AI Services
XAI_API_KEY=your_xai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# X (Twitter) API v2
X_BEARER_TOKEN=your_x_bearer_token_here
